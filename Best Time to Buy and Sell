#🚀121. Best Time to Buy and Sell Stock

class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        maxprofit=0
        minimum=prices[0]
        for i in range(0,len(prices)):
            if(prices[i]<minimum):
                minimum=prices[i]
            else:
                 profit=prices[i]-minimum
            if(profit>maxprofit):
                maxprofit=profit
        return maxprofit
